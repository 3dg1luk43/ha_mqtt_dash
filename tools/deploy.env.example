# Copy to tools/deploy.env (gitignored) and adjust for your Home Assistant.
# Mounted HA config directory (SMB/NFS share of /config):
HA_CONFIG=/mnt/ha_config
# Base URL used to call homeassistant.restart:
HA_URL=http://homeassistant.local:8123
# File containing a long-lived access token of an admin user:
HA_API_TOKEN_FILE=$HOME/.ha_api_token
